APP_NAME=SIGVA
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.sigva.xpertiaplus.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ============================================
# Configuración de Base de Datos para Producción
# ============================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sigva_production
DB_USERNAME=sigva_user
DB_PASSWORD=TU_PASSWORD_SEGURO_AQUI

# ============================================
# Configuración de Sesión
# ============================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.xpertiaplus.com

# ============================================
# Sanctum - Dominios del Frontend
# ============================================
SANCTUM_STATEFUL_DOMAINS=sigva.xpertiaplus.com,api.sigva.xpertiaplus.com

# ============================================
# Otros
# ============================================
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ============================================
# Mail (si necesitas enviar correos)
# ============================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@xpertiaplus.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
